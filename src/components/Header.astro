---
import Navigation from "@components/Navigation.astro";
import Container from "@components/Container.astro";
import { site } from "../site.config";
---

<a
  class="fixed -top-full left-1/2 z-50 -translate-x-1/2 bg-white px-4 py-1 text-black transition-[top] delay-150 ease-in-out focus:top-0 focus:outline-1 focus:outline-black focus:outline-dashed dark:bg-black dark:text-white dark:focus:outline-orange-500"
  href="#content">Skip to main content</a
>
<header class="py-4">
  <Container class="flex flex-wrap items-center justify-between gap-4">
    <a href="/" class="font-medium">{site.name}</a>
    <Navigation />
  </Container>
</header>
